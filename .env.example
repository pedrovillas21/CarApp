# Copie para .env.local e preencha. O .env.local não vai para o git.

# --- Front-end (vai para o navegador; são valores públicos) ---
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-ou-publishable-key

# --- Só para os scripts de terminal (NUNCA prefixe com VITE_) ---
# Supabase > Connect > Session pooler (porta 5432). Funciona em IPv4 e na Vercel.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API > service_role (secreta). Usada por npm run user:create.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
